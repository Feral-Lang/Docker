let vec = import('std/vec');
let package = import('std/package');

let pkg = package.new(
    name = 'Docker',
    desc = 'A Docker interface with some opinionated tools.',
    version = '0.1.0',
    feral = '>=2.2.1',
    author = vec.new('Chirag-Khandelwal <github@mail.chiragkh.me>')
);

pkg.requires('Infra', version = '>=0.1.0', feral = true);
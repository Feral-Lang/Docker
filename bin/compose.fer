#!/usr/bin/env feral

let io = import('std/io');
let os = import('std/os');
let argparse = import('std/argparse');

let compose = import('docker/compose');

let args = argparse.new('Docker', 'Docker compose commands on remote machines');
args.addPos("host").setReqd(true).setHelp("Host to connect to");
args.addPos("subcmd").setReqd(true).setHelp("Subcommand - one of: u(p)|d(own)|r(estart)|p(ull)|up(g)rade");
args.addOpt("group").addOpts('--group', '-g').setNargs(1).setHelp("Work on a specific group (folder) instead of all subfolders/specific applications");
args.parse(feral.args);

compose.init(args.getValue('host'));

let subCmd = args.getValue('subcmd');
let group = args.getValue('group');
let apps = args.getPassthrough();

if subCmd == 'u' || subCmd == 'up' {
    if !compose.up(group, apps) {
        feral.exit(1);
    }
} elif subCmd == 'd' || subCmd == 'down' {
    if !compose.down(group, apps) {
        feral.exit(1);
    }
} elif subCmd == 'r' || subCmd == 'restart' {
    if !compose.down(group, apps) || !compose.up(group, apps) {
        feral.exit(1);
    }
} elif subCmd == 'p' || subCmd == 'pull' {
    if !compose.pull(group, apps) {
        feral.exit(1);
    }
} elif subCmd == 'g' || subCmd == 'upgrade' {
    if !compose.down(group, apps) || !compose.pull(group, apps) || !compose.up(group, apps) {
        feral.exit(1);
    }
} else {
    io.println('Invalid subcommand, possible options are: u(p)|d(own)|r(estart)|p(ull)|up(g)rade');
    feral.exit(1);
}
